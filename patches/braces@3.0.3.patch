diff --git a/lib/depth.js b/lib/depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..8a7151e1efae0ee011829cfa18e38b40183ac2e1
--- /dev/null
+++ b/lib/depth.js
@@ -0,0 +1,31 @@
+'use strict';
+
+const MAX_DEPTH = 128;
+
+const checkDepth = depth => {
+  if (depth > MAX_DEPTH) {
+    throw new SyntaxError(`Input nesting depth exceeds maximum (${MAX_DEPTH})`);
+  }
+};
+
+// Validate AST input iteratively before any recursive walker. Parent references
+// are normal in parsed ASTs, but an excessive or cyclic parent chain is not.
+const assertDepth = ast => {
+  const pending = [[ast, 0]];
+  while (pending.length > 0) {
+    const [node, depth] = pending.pop();
+    if (!node || typeof node !== 'object') continue;
+    checkDepth(depth - (Array.isArray(node.nodes) ? 0 : 1));
+    let parent = node.parent;
+    let parentDepth = 0;
+    while (parent) {
+      checkDepth(parentDepth++);
+      parent = parent.parent;
+    }
+    if (node.nodes) {
+      for (const child of node.nodes) pending.push([child, depth + 1]);
+    }
+  }
+};
+
+module.exports = { checkDepth, assertDepth };
