{
  "name": "@kyudaisai/storybook-native",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "cross-env STORYBOOK_ENABLED=true expo start",
    "ios": "cross-env STORYBOOK_ENABLED=true expo start --ios",
    "android": "cross-env STORYBOOK_ENABLED=true expo start --android",
    "generate": "sb-rn-get-stories -c .rnstorybook",
    "typecheck": "tsc --noEmit",
    "export": "cross-env STORYBOOK_ENABLED=true STORYBOOK_SERVER=false STORYBOOK_DISABLE_TELEMETRY=true expo export --platform ios --platform android",
    "test": "jest --runInBand",
    "build:ios": "cross-env STORYBOOK_ENABLED=true expo run:ios",
    "build:android": "cross-env STORYBOOK_ENABLED=true expo run:android",
    "go": "cross-env STORYBOOK_ENABLED=true expo start --go"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "5.2.14",
    "@kyudaisai/tokens": "workspace:*",
    "@kyudaisai/ui-native": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/slider": "5.2.0",
    "@storybook/addon-ondevice-actions": "10.6.2",
    "@storybook/addon-ondevice-controls": "10.6.2",
    "@storybook/react-native": "10.6.2",
    "cross-env": "10.1.0",
    "expo": "57.0.28",
    "expo-asset": "~57.0.19",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-sharing": "~57.0.23",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "storybook": "10.6.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "react-dom": "19.2.3",
    "react-test-renderer": "19.2.3",
    "typescript": "6.0.3"
  }
}
