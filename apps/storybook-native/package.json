{
  "name": "@kyudaisai/storybook-native",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "cross-env STORYBOOK_ENABLED=true expo start",
    "ios": "cross-env STORYBOOK_ENABLED=true expo start --ios",
    "android": "cross-env STORYBOOK_ENABLED=true expo start --android",
    "generate": "sb-rn-get-stories -c .rnstorybook",
    "typecheck": "tsc --noEmit",
    "export": "cross-env STORYBOOK_ENABLED=true STORYBOOK_SERVER=false STORYBOOK_DISABLE_TELEMETRY=true expo export --platform ios --platform android",
    "test": "jest --runInBand",
    "build:ios": "cross-env STORYBOOK_ENABLED=true expo run:ios",
    "build:android": "cross-env STORYBOOK_ENABLED=true expo run:android",
    "go": "cross-env STORYBOOK_ENABLED=true expo start --go"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "5.2.14",
    "@kyudaisai/tokens": "workspace:*",
    "@kyudaisai/ui-native": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/slider": "5.2.1",
    "@storybook/addon-ondevice-actions": "10.6.2",
    "@storybook/addon-ondevice-controls": "10.6.2",
    "@storybook/react-native": "10.6.2",
    "cross-env": "10.1.0",
    "expo": "58.0.10",
    "expo-asset": "~58.0.15",
    "expo-camera": "~58.0.10",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.13",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.9",
    "expo-glass-effect": "~58.0.3",
    "expo-image": "~58.0.14",
    "expo-image-manipulator": "~58.0.14",
    "expo-image-picker": "~58.0.10",
    "expo-sharing": "~58.0.18",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-native": "0.88.0-rc.4",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.15.5",
    "react-native-worklets": "0.13.0",
    "storybook": "10.6.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jest": "^29.7.0",
    "jest-expo": "~58.0.10",
    "react-dom": "19.3.0",
    "react-test-renderer": "19.3.0",
    "typescript": "6.0.3"
  }
}
