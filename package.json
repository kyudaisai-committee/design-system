{
  "name": "design-system",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @kyudaisai/docs --filter @kyudaisai/storybook dev",
    "build": "pnpm --filter @kyudaisai/ui build && pnpm --filter @kyudaisai/docs build && pnpm --filter @kyudaisai/storybook build && node scripts/assemble.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "pnpm lint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "preview": "http-server dist -p 4321 -c-1",
    "check": "pnpm lint && pnpm format:check && pnpm tokens:check && pnpm tokens:test && pnpm dependencies:test && pnpm design:check && pnpm typecheck && pnpm native:typecheck && pnpm native:test && pnpm test && pnpm build && pnpm native:export && node scripts/check-catalog.mjs && pnpm site:check && pnpm package:check",
    "dependencies:test": "node --test scripts/dependency-security.test.mjs",
    "design:sync": "pnpm tokens:build && node scripts/design-tokens.mjs --write",
    "design:check": "node scripts/check-design.mjs",
    "native:dev": "pnpm --filter @kyudaisai/storybook-native dev",
    "native:ios": "pnpm --filter @kyudaisai/storybook-native ios",
    "native:android": "pnpm --filter @kyudaisai/storybook-native android",
    "native:typecheck": "pnpm --filter @kyudaisai/storybook-native generate && pnpm --filter @kyudaisai/storybook-native typecheck",
    "native:test": "pnpm --filter @kyudaisai/storybook-native test",
    "native:export": "pnpm --filter @kyudaisai/storybook-native export",
    "tokens:build": "node scripts/token-build.mjs",
    "tokens:check": "node scripts/token-build.mjs --check",
    "tokens:test": "node --test scripts/token-build.test.mjs",
    "prepare": "lefthook install",
    "native:build:ios": "pnpm --filter @kyudaisai/storybook-native build:ios",
    "native:build:android": "pnpm --filter @kyudaisai/storybook-native build:android",
    "package:check": "node scripts/check-package.mjs",
    "site:check": "node --test scripts/check-site.test.mjs && node scripts/check-site.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@google/design.md": "0.4.0",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/browser-playwright": "5.0.4",
    "http-server": "14.1.1",
    "lefthook": "2.1.17",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "parse5": "7.3.0",
    "playwright": "1.64.0",
    "storybook": "10.6.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.1.3"
}
