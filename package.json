{
  "name": "design-system",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @kyudaisai/docs --filter @kyudaisai/storybook dev",
    "build": "pnpm --filter @kyudaisai/ui build && pnpm --filter @kyudaisai/docs build && pnpm --filter @kyudaisai/storybook build && node scripts/assemble.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "http-server dist -p 4321 -c-1",
    "check": "pnpm design:check && pnpm typecheck && pnpm test && pnpm build && node scripts/check-catalog.mjs",
    "design:sync": "node scripts/design-tokens.mjs --write",
    "design:check": "node scripts/check-design.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@google/design.md": "0.4.0",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/browser-playwright": "5.0.4",
    "http-server": "14.1.1",
    "playwright": "1.64.0",
    "storybook": "10.6.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "yaml": "2.9.1"
  },
  "type": "module"
}
