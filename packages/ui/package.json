{
  "name": "@kyudaisai/ui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "files": [
    "dist",
    "src/components",
    "src/lib",
    "src/hooks",
    "src/styles",
    "LICENSE.shadcn",
    "LICENSE.txt"
  ],
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    },
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./tokens.css": {
      "types": "./src/styles/tokens.css.d.ts",
      "default": "./src/styles/tokens.css"
    }
  },
  "scripts": {
    "build": "tsup && tailwindcss -i src/styles/styles.css -o dist/styles.css --minify && cp src/styles/styles.css.d.ts dist/styles.css.d.ts && cp ../../LICENSE.txt LICENSE.txt",
    "prepack": "pnpm --dir ../.. tokens:check && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.56.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.4",
    "tailwindcss": "4.3.3",
    "tsup": "8.5.1",
    "tw-animate-css": "1.4.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
