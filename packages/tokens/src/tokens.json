        "sidebar-border": "var(--border)",
        "sidebar-ring": "var(--ring)",
        "destructive": "#b91c1c",
        "destructive-foreground": "#fff",
        "success": "#166534",
        "success-background": "#f0fdf4",
        "warning": "#854d0e",
        "warning-background": "#fefce8",
        "danger": "#991b1b",
        "danger-background": "#fef2f2",
        "info": "#1e40af",
        "info-background": "#eff6ff",
