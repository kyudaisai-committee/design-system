        "content-width": "72rem",
        "motion-fast": "120ms"
      }
    },
    "dark": {
      "selectors": [".dark", "[data-theme=\"dark\"]"],
      "colorScheme": "dark",
      "values": {
        "background": "oklch(0.145 0 0)",
