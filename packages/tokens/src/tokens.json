        "radius-sm": "0.375rem",
        "radius-md": "0.5rem",
        "radius-lg": "var(--radius)",
        "radius-xl": "0.875rem",
        "space-1": "0.25rem",
        "space-2": "0.5rem",
        "space-3": "0.75rem",
        "space-4": "1rem",
        "space-6": "1.5rem",
        "space-8": "2rem",
        "space-12": "3rem",
        "font-sans": "\"Geist\", \"Hiragino Sans\", \"Noto Sans JP\", \"Yu Gothic\", Meiryo, sans-serif",
