        "destructive-foreground": "#450a0a",
        "success": "#bbf7d0",
        "success-background": "#052e16",
        "warning": "#fef08a",
        "warning-background": "#422006",
        "danger": "#fecaca",
        "danger-background": "#450a0a",
        "info": "#bfdbfe",
        "info-background": "#172554"
      }
    }
